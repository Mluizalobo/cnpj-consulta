# Copie este arquivo para ".env.local" e preencha com os dados do seu projeto Supabase.
# Supabase > Project Settings > API (ou "Data API")
# Estas duas chaves são PÚBLICAS por natureza (a segurança vem das regras RLS do banco).
# NUNCA coloque aqui a chave "service_role" / "secret".
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=cole-aqui-a-chave-anon-ou-publishable

# ---------- Somente no SERVIDOR (Vercel > Settings > Environment Variables). NUNCA use NEXT_PUBLIC_ nelas. ----------
# Chave "service_role"/"secret" do Supabase: permite ao monitoramento gravar novidades do concurso.
SUPABASE_SERVICE_ROLE_KEY=
# Segredo longo e aleatório que protege a rota de verificação automática (Vercel Cron / GitHub Actions).
CRON_SECRET=
# Opcional: e-mails autorizados a usar as rotas do servidor (separados por vírgula).
ALLOWED_EMAILS=
# Opcional (gratuito): chave do Google AI Studio para completar campos difíceis dos editais.
GEMINI_API_KEY=
